generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String    @id @default(cuid())
  name        String
  email       String    @unique
  password    String
  image       String?
  bio         String?
  github      String?
  linkedin    String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}